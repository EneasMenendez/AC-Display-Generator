{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022"],
    "types": ["node"],
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "noEmit": true,
    "composite": true,
    "paths": { "@shared/*": ["./src/shared/*"] }
  },
  "include": ["src/main/**/*", "src/preload/**/*", "src/shared/**/*", "src/renderer/src/sim.ts", "src/renderer/src/render/compare.ts", "src/renderer/src/render/rules.ts", "src/renderer/src/render/pageEngine.ts", "src/renderer/src/render/touchSim.ts", "electron.vite.config.ts", "tools/**/*", "tests/**/*"]
}
